# ── DATABASE ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, or local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/evotech_ai"

# ── AUTH (NextAuth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"

# ── AI PROVIDER ──────────────────────────────────────────────────────────
# EvoTech AI's provider abstraction (src/lib/ai/provider.ts) supports
# multiple backends. Set AI_PROVIDER to choose one, then fill in ONLY the
# matching key. Nothing works until a real key is supplied here — the app
# will throw a clear "AI provider not configured" error otherwise, it will
# NOT silently pretend to be connected.

AI_PROVIDER="anthropic"          # "anthropic" | "openai"

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Required if AI_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── PAYMENTS (IntaSend / M-Pesa) — wired as an interface only, see README ─
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
INTASEND_TEST_MODE="true"

# ── APP CONFIG ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="EvoTech AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
